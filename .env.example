# ---- Threadline discussion embed (public by design: appears in page HTML) ----
NEXT_PUBLIC_THREADLINE_SITE_ID=
NEXT_PUBLIC_THREADLINE_API_URL=
NEXT_PUBLIC_THREADLINE_EMBED_SRC=

# ---- Site ----
# Full public URL, no trailing slash. Used for canonical and social-preview URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin (/admin). Admin is disabled when ADMIN_PASSWORD is empty. ----
ADMIN_PASSWORD=
# Optional. Signs the admin session cookie. Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Optional. Salt for hashing anonymous voter IDs. Set a long random string in production.
VOTE_SALT=

# ---- Supabase (leave empty to use the local JSON file store in development) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # public browser key for Supabase Auth; safe to expose with RLS enabled
SUPABASE_SERVICE_ROLE_KEY=   # server only. Never prefix with NEXT_PUBLIC_

# ---- Analytics ----
# Events are always stored in your own database (see /admin). Optional: if a
# dataLayer exists on the page, events are mirrored into it.
NEXT_PUBLIC_ANALYTICS_ID=
